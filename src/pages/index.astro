---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FeaturesSection from "../components/FeaturesSection.astro";
import StepsSection from "../components/StepsSection.astro";
import CommunityRulesSection from "../components/CommunityRulesSection.astro";
import NewsBoardSection from "../components/NewsBoardSection.astro";
import FaqSection from "../components/FaqSection.astro";
---

<BaseLayout
	title="Station48 | Cobblemon + Create Community Server"
	description="Station48 is a welcoming Minecraft community server featuring Cobblemon and Create. Build, automate, explore, and play together."
>
	<HeroSection />
	<FeaturesSection />
	<StepsSection />
	<CommunityRulesSection />
	<NewsBoardSection
		title="News Board"
		intro="Catch the latest events, patch notes, and server-wide updates."
		limit={2}
		sectionId="news"
		showViewAll={true}
	/>
	<FaqSection />
</BaseLayout>
